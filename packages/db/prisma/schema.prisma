generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String      @id @default(uuid())
  name       String
  username   String      @unique
  password   String
  email      String
  collateral Collateral?
  askFills   Fills[]     @relation("AskFills")
  bidFills   Fills[]     @relation("BidFills")
  orders     Orders[]
  position   Positions[]
}

model Collateral {
  id        String  @id @default(uuid())
  total     BigInt
  available BigInt
  locked    BigInt?
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id])
}

model Orders {
  id         String   @id @default(uuid())
  symbol     String
  market_id  String
  margin     BigInt
  leverage   BigInt
  side       Side
  type       Type
  quantity   BigInt
  user_id    String
  created_at DateTime @default(now())
  price      BigInt
  filled_qty BigInt
  status     Status
  user       User     @relation(fields: [user_id], references: [id])
}

model Positions {
  id                String   @id @default(uuid())
  symbol            String
  market_id         String
  leverage          BigInt
  side              Side
  type              Type
  quantity          BigInt
  status            Status
  PnL               BigInt
  created_at        DateTime @default(now())
  initial_margin    BigInt
  liquidation_price BigInt
  userId            String
  entry_price       BigInt
  user              User     @relation(fields: [userId], references: [id])
}

model Fills {
  id              String   @id @default(uuid())
  quantity        BigInt
  askLeverage     BigInt
  askMargin       BigInt
  askOrderId      String
  askRole         String
  askUserId       String
  bidLeverage     BigInt
  bidMargin       BigInt
  bidOrderId      String
  bidRole         String
  bidUserId       String
  createdAt       DateTime @default(now())
  market          String
  price           BigInt
  remainingAskQty BigInt
  remainingBidQty BigInt
  askUser         User     @relation("AskFills", fields: [askUserId], references: [id])
  bidUser         User     @relation("BidFills", fields: [bidUserId], references: [id])
}

enum Side {
  LONG
  SHORT
}

enum Type {
  MARKET
  LIMIT
}

enum Status {
  OPEN
  CLOSED
  PARTIALLY_FILLED
  FAILED
  LIQUIDATED
}
